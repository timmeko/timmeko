---
layout: base
title: Tim Meko - Visual Journalist & Graphics Editor
---

<section class="hero section">
  <div class="container">
    <div class="hero-content">
      <h1>Maps and data visualization</h1>
      <p class="hero-statement">I lead teams that explain the world's most important stories with maps, data visualization, and design.</p>
    </div>
  </div>
</section>

<section id="featured" class="featured section">
  <div class="container">
    <header class="section-header">
      <h2>Featured stories</h2>
    </header>
    
    <div class="featured-list">
      {% for item in collections.flagship %}
        <article class="featured-project {{ 'featured-project--reverse' if loop.index0 % 2 == 1 }}" data-project-index="{{ loop.index0 }}">
          <div class="featured-project__media">
            <a href="{{ item.url }}" class="featured-project__media-link">
              <video class="featured-project__video" muted loop playsinline preload="metadata">
                <source src="/assets/videos/{{ item.fileSlug }}.mp4" type="video/mp4">
              </video>
            </a>
          </div>
          
          <div class="featured-project__content">
            <a href="{{ item.url }}" class="featured-project__content-link">
              <h3 class="featured-project__title">{{ item.data.title }}</h3>
              <p class="featured-project__description">
                {{ item.data.homepage_description }}
              </p>
            </a>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section id="insights" class="insights section">
  <div class="container">
    <header class="section-header">
      <h2>Talks & Articles</h2>
    </header>
    
    <div class="insights-list">
      {% for item in collections.insights %}
        <div class="insight-item">
          <h3 class="insight-title">
            {% if item.data.link %}
              <a href="{{ item.data.link }}" target="_blank" rel="noopener noreferrer">{{ item.data.title }}</a>
            {% else %}
              {{ item.data.title }}
            {% endif %}
          </h3>
          <div class="insight-meta">
            {% if item.data.type %}
              <span class="insight-type">{{ item.data.type | capitalize }}</span>
            {% endif %}
            {% if item.data.date %}
              <time class="insight-date">{{ item.data.date | dateFormat }}</time>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="editing" class="editing section">
  <div class="container">
    <header class="section-header">
      <h2>Stories I shaped</h2>
    </header>
    
    <div class="cards-grid">
      {% for item in collections.editing %}
        <article class="card">
          <a href="{% if item.data.link %}{{ item.data.link }}{% else %}{{ item.url }}{% endif %}" {% if item.data.link %}target="_blank" rel="noopener noreferrer"{% endif %} class="card-link">
            {% if item.data.hero %}
              <img src="{{ item.data.hero }}" alt="{{ item.data.title }}" class="card-image">
            {% else %}
              <div class="card-image" data-placeholder="{{ item.data.title }}"></div>
            {% endif %}
            <div class="card-content">
              <h3 class="card-title">{{ item.data.title }}</h3>
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section id="more-work" class="index section">
  <div class="container">
    <header class="section-header">
      <h2>More Work</h2>
    </header>
    
    <div class="index-grid" id="index-grid">
      {% for item in collections.more %}
        <div class="index-card" data-index="{{ loop.index }}">
          {% if item.data.hero %}
            <img src="{{ item.data.hero }}" alt="{{ item.data.title }}" class="index-image" loading="lazy">
          {% else %}
            <div class="index-image" data-placeholder="{{ item.data.title }}"></div>
          {% endif %}
          
          <div class="index-overlay">
            <div class="index-title">{{ item.data.title }}</div>
          </div>
          
          {% if item.data.link %}
            <a href="{{ item.data.link }}" target="_blank" rel="noopener noreferrer" class="index-link" aria-label="{{ item.data.title }}"></a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    
    <div class="load-more-container">
      <button id="load-more" class="load-more-btn">Show more</button>
    </div>
  </div>
</section>

<section id="about-contact" class="about-contact section">
  <div class="container">
    <header class="section-header">
      <h2>About & Contact</h2>
    </header>
    
    <div class="about-content">
      <div class="about-text">
        <p>Tim Meko is a graphics editor and visual journalist with nearly 20 years of experience turning complex ideas into clear stories. At The Washington Post he leads cross-disciplinary teams that create maps, data visualizations, and design for some of the newsroom's most impactful work. Previously he led teams at the Urban Institute and worked at the National Energy Education Development Project and the Columbus Dispatch.</p>
        
        <div class="about-links">
          <a href="https://linkedin.com/in/timmeko" target="_blank" rel="noopener noreferrer" class="about-link">LinkedIn</a>
        </div>
      </div>
      
      <div class="about-photo">
        <!-- <img src="/img/headshot.jpg" alt="Tim Meko" class="headshot"> -->
        <div class="headshot-placeholder">
          <span>Headshot needed</span>
        </div>
      </div>
    </div>
  </div>
</section>