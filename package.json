{
  "name": "timmeko-portfolio-2025-v2",
  "version": "1.0.0",
  "description": "Tim Meko's portfolio website built with Eleventy",
  "main": ".eleventy.js",
  "scripts": {
    "dev": "eleventy --serve --watch",
    "build": "npm run optimize-images && eleventy",
    "build:quick": "eleventy",
    "start": "eleventy --serve",
    "setup": "npm run download-images && npm run update-paths",
    "download-images": "node scripts/download-images.js",
    "update-paths": "node scripts/update-image-paths.js",
    "optimize-images": "node scripts/optimize-images.js",
    "optimize-videos": "node scripts/optimize-videos.js",
    "optimize-media": "npm run optimize-images && npm run optimize-videos",
    "build:with-videos": "npm run optimize-media && eleventy",
    "csv-to-md": "node scripts/csv-to-md.js",
    "fix-paths": "node scripts/fix-image-paths.js",
    "fix-broken-paths": "node scripts/fix-broken-paths.js",
    "fix-hero-column": "node scripts/fix-hero-column.js",
    "fix-placeholder-heroes": "node scripts/fix-placeholder-heroes.js",
    "refresh-images": "npm run download-images && npm run update-paths",
    "clean": "rm -rf _site && rm -rf img/raw/* && rm -rf img/optimized/*",
    "full-rebuild": "npm run clean && npm run setup && npm run build"
  },
  "keywords": [
    "portfolio",
    "mapping",
    "data-visualization",
    "eleventy"
  ],
  "author": "Tim Meko",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "sharp": "^0.32.0"
  },
  "dependencies": {
    "papaparse": "^5.4.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
